# All variables are optional.

# Port for the Express server (Render sets this automatically).
PORT=3000

# Demo fallback key used only when a request has no user key.
# Leave empty so every user brings their own free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Max API requests per IP per minute.
RATE_LIMIT_PER_MIN=60

# Public URL, sent to OpenRouter as the HTTP-Referer for app attribution.
APP_URL=
